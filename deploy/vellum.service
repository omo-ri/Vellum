# 安装位置：/etc/systemd/system/vellum.service
# 改完执行：systemctl daemon-reload && systemctl restart vellum

[Unit]
Description=Vellum
After=network-online.target
Wants=network-online.target

# 崩溃循环保护：10 秒内重启超过 5 次就放弃
# 注意这两项属于 [Unit] 段，写进 [Service] 会被 systemd 静默忽略
StartLimitIntervalSec=10
StartLimitBurst=5

[Service]
User=vellum
Group=vellum
EnvironmentFile=/etc/vellum/env
WorkingDirectory=/srv/vellum
ExecStart=/opt/vellum/vellum serve
Restart=always
RestartSec=2

# 安全加固
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/vellum
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
